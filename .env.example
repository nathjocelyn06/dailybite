# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NOT USED since v3.1 — the browser never talks to Supabase. Kept only for a future signed-in mode.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never prefix with NEXT_PUBLIC_. Used by the MCP server to write as you.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single owner's user id (Supabase > Authentication > Users > Add user, auto-confirm).
# Nobody signs in as it: the app has no login and acts as this user, and every table's
# user_id is a foreign key to auth.users. REQUIRED — the app cannot read anything without it.
OWNER_USER_ID=00000000-0000-0000-0000-000000000000
# The owner user's email. Not used to sign in (there is no sign-in); kept for reference
# and for recreating the owner user.
OWNER_EMAIL=you@example.com

# Only needed where something else injects NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# (Vercel's Supabase storage connection does). These win when set. Leave blank locally.
DAILYBITE_SUPABASE_URL=
DAILYBITE_SUPABASE_SERVICE_KEY=

# ---- App ----
# Public URL of the deployed app, used in links returned by MCP tools.
APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Seoul

# Long random string. Claude connects to: {APP_URL}/api/mcp?key=MCP_ACCESS_KEY
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_ACCESS_KEY=change-me

# ---- Optional ----
# AI food recognition on /snap. Set ONE of these; Gemini is picked first because its
# free tier needs no card. VISION_PROVIDER (gemini|anthropic) forces a specific one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VISION_PROVIDER=

# Alternative provider. Without any key, scans open an empty form to fill by hand.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Extra recipe videos from YouTube Data API v3. Without it, recipes still show TheMealDB's video
# and a "Search on YouTube" link.
YOUTUBE_API_KEY=
# TheMealDB: "1" is the free test key.
MEALDB_API_KEY=1
